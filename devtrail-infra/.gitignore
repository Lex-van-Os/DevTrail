# ============================================================

# Terraform

# ============================================================

# Terraform working directory

.terraform/

# Terraform state files

*.tfstate
*.tfstate.*

# Terraform crash logs

crash.log
crash.*.log

# Terraform plan files

*.tfplan
*.tfplan.*

# Terraform variable files

# These often contain secrets or environment-specific values

*.tfvars
*.tfvars.json

# Allow example/template variable files

!*.tfvars.example

# Terraform override files

override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration

.terraformrc
terraform.rc

# ============================================================

# Secrets / Credentials

# ============================================================

# Local environment files

.env
.env.*

# Allow example environment files

!.env.example

# Azure credentials / service principal files

azure-credentials.json
credentials.json

# Generic private keys

*.pem
*.key
*.p12
*.pfx

# ============================================================

# IDE / Editor

# ============================================================

# Visual Studio Code

.vscode/

# macOS

.DS_Store

# ============================================================

# Logs

# ============================================================

*.log

# ============================================================

# Temporary files

# ============================================================

*.tmp
*.temp
*~
EOF
